# Copia este archivo como .env y cambia las contraseñas. El .env nunca se sube a git.

# --- Puertos en tu computadora ---
# Cámbialos si ya tienes otro programa usando alguno (y ajusta las URL de abajo).
POSTGRES_PORT=5432
REDIS_PORT=6379
EVOLUTION_PORT=8080

# --- PostgreSQL (docker-compose) ---
# Dueño de las tablas: crea el esquema y corre las migraciones. No pasa por RLS.
POSTGRES_USER=saint_owner
POSTGRES_PASSWORD=cambia-esta-clave-owner
POSTGRES_DB=saint
# Usuario con el que se conecta la aplicación. Sí pasa por RLS.
APP_DB_USER=saint_app
APP_DB_PASSWORD=cambia-esta-clave-app
# Usuario y base propios de Evolution API (base de datos "evolution").
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=cambia-esta-clave-evolution

# --- Backend ---
# Usa 127.0.0.1 y no "localhost": en Windows, "localhost" prueba primero IPv6 (::1)
# y cada conexión tarda ~2 s más, lo que hace fallar el /health (límite de 2 s).
# Conexión de la aplicación (usuario sin privilegios, con RLS)
DATABASE_URL=postgresql+asyncpg://saint_app:cambia-esta-clave-app@127.0.0.1:5432/saint
# Conexión para migraciones y tareas de administración (dueño de las tablas)
DATABASE_ADMIN_URL=postgresql+asyncpg://saint_owner:cambia-esta-clave-owner@127.0.0.1:5432/saint
REDIS_URL=redis://127.0.0.1:6379/0
APP_ENV=development

# --- Evolution API ---
# Dirección donde la API de Saint encuentra a Evolution.
EVOLUTION_BASE_URL=http://127.0.0.1:8080
# Clave maestra de Evolution: cámbiala por una larga y aleatoria. Por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_API_KEY=cambia-esta-clave-evolution-api
# Dirección con la que Evolution (dentro de Docker) llega a la API de Saint.
# En desarrollo es tu computadora vista desde Docker. En producción: https://api.tu-dominio
PUBLIC_WEBHOOK_BASE_URL=http://host.docker.internal:8000

# --- Cifrado ---
# Clave para cifrar los tokens guardados en la base. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la pierdes, los tokens guardados ya no se pueden leer: guárdala con las demás claves.
FERNET_KEY=

# --- Bot ---
# Solo para pruebas: teléfonos (con código de país, separados por coma) a los que el bot
# contesta. Vacío = contesta a todos los clientes que escriban al número.
BOT_TEST_PHONES=

# --- IA ---
# Clave de Anthropic (https://console.anthropic.com). Sin ella el bot contesta con un eco.
ANTHROPIC_API_KEY=

# --- Panel (inicio de sesión) ---
# Clave que firma los pases de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Direcciones del panel web que pueden llamar a la API (separadas por coma).
PANEL_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Dirección del panel que va en los enlaces de invitación.
PANEL_URL=http://127.0.0.1:5173

# --- Se usarán en fases siguientes (no hacen falta todavía) ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
